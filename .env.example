# MealMind configuration template.
# Copy this file to .env and put your own values there:
#     cp .env.example .env
# NEVER commit .env -- it is gitignored. This file must only ever contain placeholders.

# openai (primary) or ollama (local, no key needed)
LLM_PROVIDER=openai
# Your OpenAI API key; not needed when LLM_PROVIDER=ollama
LLM_API_KEY=YOUR_LOCAL_API_KEY_HERE
# Optional model name. If unset, the default is gpt-4o for openai and llama3 for ollama.
# LLM_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
LLM_TIMEOUT_SECONDS=30
