@startuml seq-f05-rule-plan
title F05 rule-based plan generation (offline fallback, no AI)
skinparam shadowing false
autonumber

actor User
participant "PlanGenerationCommands (CLI)\nor PlanGenerateBar (GUI)" as UI
participant ApplicationContext
participant RulePlanner
participant ConstraintValidator
participant PlanningStrategy
participant RecipeScaler
participant "new MealPlan" as Plan

User -> UI : plan generate --days 3 --strategy budget
UI -> UI : parse PlanRequest; refuse if plan has meals\nwithout --replace (GUI: confirmation dialog)
UI -> ApplicationContext : planner()
UI -> RulePlanner : generate(request)
RulePlanner -> ConstraintValidator : validateAgainstBlacklists (safe pool)
RulePlanner -> RulePlanner : drop 1-2 star recipes (if others remain)
loop each day, each slot
  RulePlanner -> PlanningStrategy : score(recipe, ScoringContext)
  RulePlanner -> RulePlanner : least used, then best score,\nfavourite, rating, id
  RulePlanner -> RecipeScaler : scale(recipe, householdServings)
  RulePlanner -> Plan : setMeal(day, slot, meal)
end
RulePlanner -> ConstraintValidator : validateMacrosAndAllergens(plan)
RulePlanner --> UI : PlanResult (plan, validation, notes)
UI -> ApplicationContext : newPlan(days) (clears undo history)
UI -> ApplicationContext : copy meals into the current plan
note right of UI : GUI: PlanBindings.repoint() re-binds\nthe plan and shopping-list observers
UI --> User : headline, notes, Warning:/SAFETY: lines
@enduml
