@startuml pattern-command
!pragma layout smetana
title Command pattern - undoable changes (package com.mealmind.command)
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

interface Command <<Command>> {
  +execute()
  +undo()
  +description() : String
}
abstract class AbstractCommand {
  +execute()
  +undo()
  #doExecute()
  #doUndo()
}
class CommandHistory <<Invoker>> {
  +pushAndExecute(Command)
  +undo() : boolean
  +redo() : boolean
  +nextUndoDescription()
  +clear()
}
class AddPantryItemCommand
class RemovePantryItemCommand
class ReplaceMealCommand
class ClearMealCommand
class ScaleRecipeCommand
class SaveRecipeCommand
class RemoveRecipeCommand

package "Receivers" {
  class Pantry
  class MealPlan
  class RecipeBook
}
package "Clients" {
  class CLIHandler
  class "PantryTab / RecipeDetailsPane /\nPlanSlotEditor (GUI)" as GuiClients
  class PlanEditor
  class AgentFacade
}

Command <|.. AbstractCommand
AbstractCommand <|-- AddPantryItemCommand
AbstractCommand <|-- RemovePantryItemCommand
AbstractCommand <|-- ReplaceMealCommand
AbstractCommand <|-- ClearMealCommand
AbstractCommand <|-- ScaleRecipeCommand
AbstractCommand <|-- SaveRecipeCommand
AbstractCommand <|-- RemoveRecipeCommand
CommandHistory o-- "undo/redo stacks" Command
AddPantryItemCommand --> Pantry
RemovePantryItemCommand --> Pantry
ReplaceMealCommand --> MealPlan
ClearMealCommand --> MealPlan
ScaleRecipeCommand --> RecipeBook
SaveRecipeCommand --> RecipeBook
RemoveRecipeCommand --> RecipeBook
CLIHandler ..> CommandHistory
GuiClients ..> CommandHistory
PlanEditor ..> CommandHistory : AI plan edits
AgentFacade ..> CommandHistory : savePendingRecipe
@enduml
