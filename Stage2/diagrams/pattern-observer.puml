@startuml pattern-observer
!pragma layout smetana
title Observer pattern (core) - subjects and observers in the model layer
skinparam shadowing false
skinparam classAttributeIconSize 0
hide empty members

abstract class ObservableSubject <<Subject>> {
  -observers : CopyOnWriteArrayList<ModelObserver>
  +addObserver(ModelObserver)
  +removeObserver(ModelObserver)
  #notifyObservers(String)
}
interface ModelObserver <<Observer>> {
  +onStateChanged(ChangeEvent)
}
class ChangeEvent <<record>> {
  source : ObservableSubject
  description : String
}
class Pantry <<ConcreteSubject>>
class MealPlan <<ConcreteSubject>>
class RecipeBook <<ConcreteSubject>>
class UserProfile <<ConcreteSubject>>
class ShoppingListGenerator <<ConcreteSubject + ConcreteObserver>> {
  +generate() : ShoppingList
  +getCurrent() : ShoppingList
}
class RecipePreferences <<ConcreteSubject + ConcreteObserver>>
class CLIConsoleView <<ConcreteObserver>>
note "Other subjects: DayPlan (forwarded by MealPlan),\nCommandHistory, LlmService, AgentFacade.\nApplicationContext registers autosave observers\non Pantry, UserProfile, RecipeBook and RecipePreferences." as N1

ObservableSubject o-- "*" ModelObserver
ModelObserver ..> ChangeEvent
ObservableSubject <|-- Pantry
ObservableSubject <|-- MealPlan
ObservableSubject <|-- RecipeBook
ObservableSubject <|-- UserProfile
ObservableSubject <|-- ShoppingListGenerator
ObservableSubject <|-- RecipePreferences
ModelObserver <|.. ShoppingListGenerator
ModelObserver <|.. RecipePreferences
ModelObserver <|.. CLIConsoleView
ShoppingListGenerator ..> Pantry : observes
ShoppingListGenerator ..> MealPlan : observes
RecipePreferences ..> RecipeBook : observes (prunes deleted ids)
CLIConsoleView ..> ShoppingListGenerator : observes, prints [update]
@enduml
