@startuml seq-f06-plan-edit
title F06 natural-language plan edit - AI interprets, checker and editor validate, Command executes
skinparam shadowing false
autonumber

actor User
participant "PlanEditCommands (CLI)\nor PlanChatBar (GUI)" as UI
participant AgentFacade
participant AgentLoop
participant PlanEditChecker
participant PlanEditor
participant ConstraintValidator
participant CommandHistory
participant MealPlan

User -> UI : plan edit "swap tuesday dinner..."
UI -> AgentFacade : editPlan(instruction, plan, history, activity)
note right of AgentFacade : availability check, busy guard,\nseed = PlanEditPrompt + memory
AgentFacade -> AgentLoop : run(seed, "edit", PlanEditChecker)
loop tool calls (e.g. recipe_search) and answers
  AgentLoop -> PlanEditChecker : check({"edit": ...})
  PlanEditChecker -> ConstraintValidator : validateAgainstBlacklists(recipe)
  alt unknown id / bad day / empty slot
    PlanEditChecker --> AgentLoop : Repair
  else unsafe recipe
    PlanEditChecker --> AgentLoop : Unsafe (retry)
  else ok
    PlanEditChecker --> AgentLoop : Accepted(proposal)
  end
end
AgentLoop --> AgentFacade : AgentRun
alt ACCEPTED (replace or clear)
  AgentFacade -> PlanEditor : apply(proposal, plan, history)
  PlanEditor -> ConstraintValidator : re-check against CURRENT profile
  PlanEditor -> CommandHistory : pushAndExecute(ReplaceMealCommand / ClearMealCommand)
  CommandHistory -> MealPlan : setMeal / clearMeal
  MealPlan -> MealPlan : notifyObservers (views refresh)
  AgentFacade -> AgentFacade : memory: "Applied: ..."
else CLARIFY
  AgentFacade --> UI : "Question: ..." (plan unchanged)
else UNSAFE after retries
  AgentFacade --> UI : REFUSED (nothing executed, no memory)
end
AgentFacade --> UI : PlanEditResult + stats line
@enduml
