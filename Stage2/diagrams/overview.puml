@startuml overview
!pragma layout smetana
title MealMind - package and key-class overview (Stage 2, as implemented)
skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "app" {
  class ApplicationContext
  class Startup
}
package "cli" {
  class CLIHandler
  class CLIConsoleView
}
package "gui" {
  class MainController
  class "Profile/Pantry/Recipes/\nPlan/Shopping/Nutrition tabs" as Tabs
}
package "gui.logic (no JavaFX)" as guilogic {
  class ObserverBinding
  class BackgroundRunner
}
package "agent" {
  class AgentFacade
  class AgentLoop
  class RecipeGenerator
}
package "llm" {
  interface LLMClient
  class LlmService
}
package "tools" {
  class ToolManager
}
package "model" {
  interface MealComponent
  class MealPlan
  class RecipeBook
  abstract class ObservableSubject
}
package "command" {
  class CommandHistory
}
package "pantry" {
  class Pantry
}
package "profile" {
  class UserProfile
}
package "validation" {
  class ConstraintValidator
}
package "planning" {
  interface PlanningStrategy
  class RulePlanner
}
package "shopping" {
  class ShoppingListGenerator
}
package "persistence" {
  class JsonFiles
}

CLIHandler --> ApplicationContext
MainController --> ApplicationContext
MainController --> Tabs
Tabs ..> ObserverBinding
Tabs ..> BackgroundRunner
CLIHandler ..> CLIConsoleView
ApplicationContext *-- AgentFacade
ApplicationContext *-- CommandHistory
ApplicationContext *-- Pantry
ApplicationContext *-- RecipeBook
ApplicationContext *-- UserProfile
ApplicationContext *-- LlmService
ApplicationContext *-- RulePlanner
ApplicationContext *-- ShoppingListGenerator
ApplicationContext ..> JsonFiles : autosave
AgentFacade --> RecipeGenerator
RecipeGenerator --> AgentLoop
AgentLoop --> LlmService
AgentLoop --> ToolManager
LlmService o-- LLMClient
AgentFacade --> ConstraintValidator
RulePlanner --> PlanningStrategy
ShoppingListGenerator --> MealPlan
ShoppingListGenerator --> Pantry
MealPlan ..|> MealComponent
@enduml
