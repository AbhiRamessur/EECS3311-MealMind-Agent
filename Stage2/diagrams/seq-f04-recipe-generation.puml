@startuml seq-f04-recipe-generation
title F04 AI recipe generation - agent loop, tool call, safety retry, pending candidate
skinparam shadowing false
skinparam sequenceMessageAlign center
autonumber

actor User
participant "AgentCommands (CLI)\nor GeneratePane (GUI)" as UI
participant AgentFacade
participant RecipeGenerator
participant AgentLoop
participant LlmService
participant ToolManager
participant RecipeDraftParser
participant ConstraintValidator

User -> UI : recipe generate "..." / Generate
UI -> AgentFacade : generateRecipe(prompt, activity)
note right of AgentFacade : availability check first;\nbusy guard (one job at a time)
AgentFacade -> RecipeGenerator : generate(prompt, listener)
RecipeGenerator -> AgentLoop : run(seed, "recipe", checker, listener)
loop until accepted or budgets used up
  AgentLoop -> LlmService : complete(request, JSON mode)
  LlmService --> AgentLoop : reply text
  alt reply is {"tool": ...}
    AgentLoop -> ToolManager : execute(call)
    ToolManager --> AgentLoop : result (data, not instructions)
  else reply is {"recipe": ...}
    AgentLoop -> RecipeDraftParser : parse(answer, id)
    alt malformed or implausible
      AgentLoop -> LlmService : repair prompt (max 2)
    else parsed
      AgentLoop -> ConstraintValidator : validateAgainstBlacklists(recipe)
      alt SAFETY violation
        AgentLoop -> LlmService : safety feedback (max 3 retries)
      else safe
        AgentLoop --> RecipeGenerator : ACCEPTED
      end
    end
  end
end
RecipeGenerator --> AgentFacade : GeneratedRecipe (safe or flagged)
AgentFacade -> AgentFacade : store as pending, notifyObservers
AgentFacade --> UI : preview + safety banner
note over UI, AgentFacade : nothing is saved: "recipe save" / Save calls\nsavePendingRecipe(history), which re-validates\nand runs SaveRecipeCommand (undoable)
@enduml
